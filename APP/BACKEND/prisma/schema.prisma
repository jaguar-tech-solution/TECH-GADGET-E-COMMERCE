// prisma/schema.prisma
// Prisma 7: the datasource URL belongs in prisma.config.ts, not here.
// CHECK constraints, partial indexes, triggers and sequences live in constraints.sql.

generator client {
  provider = "prisma-client-js"
  
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
  RETURNED
}

enum OrderPaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  RECONCILIATION_REQUIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  RECONCILIATION_REQUIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum MovementType {
  INITIAL_STOCK
  STOCK_RECEIVED
  MANUAL_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  FULFILLMENT
  RETURN_RECEIVED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

// AUTHENTICATION & ACCESS CONTROL

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  email           String     @unique @db.VarChar(255)
  phone           String?    @db.VarChar(30)
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz()
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  userRoles          UserRole[]
  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  refreshSessions    RefreshSession[]
  statusChanges      OrderStatusHistory[]
  refundsCreated     Refund[]

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique @db.VarChar(120)
  description String?

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.Inet
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// ------------------------------------------------------
// CATALOG & PRODUCTS
// ------------------------------------------------------

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(150)
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  name           String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(220)
  sku            String        @unique @db.VarChar(100)
  brand          String?       @db.VarChar(120)
  description    String?
  specifications Json?         @db.JsonB
  priceMinor     BigInt        @map("price_minor")
  currency       String        @default("KES") @db.Char(3)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId, status])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  imageUrl     String   @map("image_url")
  altText      String?  @map("alt_text") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

// INVENTORY MANAGEMENT

model Inventory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryId    String       @map("inventory_id") @db.Uuid
  movementType   MovementType @map("movement_type")
  quantityChange Int          @map("quantity_change")
  referenceType  String?      @map("reference_type") @db.VarChar(40)
  referenceId    String?      @map("reference_id") @db.Uuid
  note           String?
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  creator   User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@map("inventory_movements")
}

// ------------------------------------------------------
// ADDRESSES & CARTS
// ------------------------------------------------------

model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(30)
  addressLine1  String   @map("address_line_1") @db.VarChar(255)
  addressLine2  String?  @map("address_line_2") @db.VarChar(255)
  city          String   @db.VarChar(120)
  county        String?  @db.VarChar(120)
  postalCode    String?  @map("postal_code") @db.VarChar(30)
  country       String   @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  guestTokenHash String?    @unique @map("guest_token_hash")
  status         CartStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz()

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ORDERS & FULFILLMENT
model ShippingMethod {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String  @db.VarChar(120)
  description      String?
  feeMinor         BigInt  @map("fee_minor")
  currency         String  @default("KES") @db.Char(3)
  estimatedDaysMin Int?    @map("estimated_days_min")
  estimatedDaysMax Int?    @map("estimated_days_max")
  isActive         Boolean @default(true) @map("is_active")

  orders    Order[]
  shipments Shipment[]

  @@map("shipping_methods")
}

model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  orderNumber             String             @unique @map("order_number") @db.VarChar(50)
  userId                  String?            @map("user_id") @db.Uuid
  status                  OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus           OrderPaymentStatus @default(UNPAID) @map("payment_status")
  currency                String             @db.Char(3)
  subtotalMinor           BigInt             @map("subtotal_minor")
  deliveryFeeMinor        BigInt             @default(0) @map("delivery_fee_minor")
  discountMinor           BigInt             @default(0) @map("discount_minor")
  totalMinor              BigInt             @map("total_minor")
  deliveryAddressSnapshot Json               @map("delivery_address_snapshot") @db.JsonB
  customerEmailSnapshot   String             @map("customer_email_snapshot") @db.VarChar(255)
  customerPhoneSnapshot   String             @map("customer_phone_snapshot") @db.VarChar(30)
  shippingMethodId        String?            @map("shipping_method_id") @db.Uuid
  reservationExpiresAt    DateTime?          @map("reservation_expires_at") @db.Timestamptz()
  guestTrackingTokenHash  String?            @unique @map("guest_tracking_token_hash")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user           User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  payments       Payment[]
  shipments      Shipment[]
  statusHistory  OrderStatusHistory[]
  refunds        Refund[]

  @@unique([id, currency])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([shippingMethodId])
  @@map("orders")
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  changedBy  String?      @map("changed_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changer User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedBy])
  @@map("order_status_history")
}

model OrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(200)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(100)
  unitPriceMinor      BigInt   @map("unit_price_minor")
  quantity            Int
  lineTotalMinor      BigInt   @map("line_total_minor")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  shippingMethodId String         @map("shipping_method_id") @db.Uuid
  trackingNumber   String?        @map("tracking_number") @db.VarChar(150)
  carrier          String?        @db.VarChar(120)
  status           ShipmentStatus @default(PENDING)
  shippedAt        DateTime?      @map("shipped_at") @db.Timestamptz()
  deliveredAt      DateTime?      @map("delivered_at") @db.Timestamptz()
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  items          ShipmentItem[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([shippingMethodId])
  @@map("shipments")
}

model ShipmentItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

// PAYMENTS & AUDIT
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @db.VarChar(80)
  providerReference String?       @map("provider_reference") @db.VarChar(255)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(255)
  amountMinor       BigInt        @map("amount_minor")
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  order   Order          @relation(fields: [orderId, currency], references: [id, currency], onDelete: Restrict)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([provider, providerReference])
  @@index([orderId, status])
  @@map("payments")
}

model PaymentEvent {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String             @map("payment_id") @db.Uuid
  provider         String             @db.VarChar(80)
  providerEventId  String             @map("provider_event_id") @db.VarChar(255)
  eventType        String             @map("event_type") @db.VarChar(120)
  processingStatus PaymentEventStatus @default(RECEIVED) @map("processing_status")
  payloadReference String?            @map("payload_reference")
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz()
  processedAt      DateTime?          @map("processed_at") @db.Timestamptz()

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId, processingStatus])
  @@map("payment_events")
}

model Refund {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  amountMinor       BigInt       @map("amount_minor")
  currency          String       @db.Char(3)
  status            RefundStatus @default(PENDING)
  reason            String?
  providerReference String?      @map("provider_reference") @db.VarChar(255)
  idempotencyKey    String       @unique @map("idempotency_key") @db.VarChar(255)
  createdBy         String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz()

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([paymentId, status])
  @@index([orderId])
  @@index([createdBy])
  @@map("refunds")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  details     Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
